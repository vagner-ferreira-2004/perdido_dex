# DBML DE REFERÊNCIA

Usar este DBML como referência para gerar/revisar o SQL, models e migrations.

```dbml
Table user {
  id_user int [pk, increment]
  name varchar(150) [not null]
  cpf varchar(11) [not null, unique]
  phone varchar(20) [not null]
  email varchar(150) [not null, unique]
  rgm varchar(20) [not null, unique]
}

Table category {
  id_category int [pk, increment]
  name varchar(100) [not null, unique]
}

Table location {
  id_location int [pk, increment]
  central_place varchar(100) [not null]
  description varchar(255) [not null]
}

Table object_found {
  id_object int [pk, increment]
  id_user int [not null]
  id_category int [not null]
  id_location int [not null]

  status varchar(30) [not null]
  found_date date [not null]
}

Table characteristic {
  id_characteristic int [pk, increment]
  id_object int [not null, unique]

  color varchar(50) [not null]
  brand varchar(100) [not null]
  description text [not null]
}

Table photo {
  id_photo int [pk, increment]
  id_object int [not null, unique]

  source varchar(500) [not null]
}

Table pickup {
  id_pickup int [pk, increment]
  id_object int [not null, unique]

  name varchar(150) [not null]
  cpf varchar(11) [not null]
  rg varchar(20) [not null]
  rgm varchar(20) [not null]
  phone varchar(20) [not null]

  person_photo varchar(500) [not null]
  pickup_date datetime [not null]
}

// Relationships

Ref: user.id_user < object_found.id_user
Ref: category.id_category < object_found.id_category
Ref: location.id_location < object_found.id_location
Ref: object_found.id_object - characteristic.id_object
Ref: object_found.id_object - photo.id_object
Ref: object_found.id_object - pickup.id_object
```

